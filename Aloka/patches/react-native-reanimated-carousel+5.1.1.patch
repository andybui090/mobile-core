+  function RacingTapAndPan({ handlers, treatStartAsUpdate }: RacingTapAndPanProps) {
+    const tap = Gesture.Tap().onBegin(handlers.begin).onEnd(handlers.end).withTestId("tap");
+
+    const pan = usePanGestureProxy({
