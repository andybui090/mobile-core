+    expect(() => {
+      fireGestureHandler<LegacyPanGesture>(getByGestureTestId("pan"), [
+        { oldState: State.UNDETERMINED, state: State.BEGAN, x: 0, y: 10 },
+        { oldState: State.UNDETERMINED, state: State.ACTIVE, x: 1, y: 11 },
