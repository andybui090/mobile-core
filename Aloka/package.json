{
  "name": "Aloka",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "install:newdevice": "brew install node watchman cocoapods cmake ninja",
    "clean": "watchman watch-del-all || true && rm -rf node_modules ios/Pods ios/Podfile.lock ios/build android/build android/.gradle android/app/build $TMPDIR/metro-* $TMPDIR/react-*",
    "clean:all": "watchman watch-del-all || true && rm -rf node_modules ios/Pods ios/Podfile.lock ios/build android/build android/.gradle android/app/build $TMPDIR/metro-* $TMPDIR/react-* && yarn cache clean",
    "install:clean": "yarn run clean && yarn install && cd ios && pod install && cd .. && open ios/Aloka.xcworkspace && yarn reset",
    "pods": "cd ios && pod install && cd ..",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "android:apk:debug": "cd android && ./gradlew assembleDebug --info --stacktrace && cd ..",
    "android:apk:release": "cd android && ./gradlew assembleRelease --info --stacktrace && cd ..",
    "android:aab:release": "cd android && ./gradlew bundleRelease --info --stacktrace && cd ..",
    "reset": "react-native start --reset-cache",
    "clear:build_ios": "rm -rf ios/build",
    "clear:DerivedData": "rm -rf ~/Library/Developer/Xcode/DerivedData/*"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@react-native-firebase/remote-config": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "7.18.8",
    "@react-navigation/native": "7.3.5",
    "@react-navigation/native-stack": "7.17.7",
    "@reduxjs/toolkit": "2.12.0",
    "@rneui/base": "^5.0.0",
    "@rneui/themed": "^5.0.0",
    "apisauce": "^3.2.2",
    "i18next": "^26.3.5",
    "i18next-chained-backend": "^5.0.5",
    "i18next-http-backend": "^4.0.0",
    "i18next-resources-to-backend": "^1.2.1",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-content-loader": "^7.1.2",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-blurhash": "^2.1.3",
    "react-native-bootsplash": "7.3.2",
    "react-native-config": "^1.6.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-keyboard-controller": "^1.21.14",
    "react-native-permissions": "^5.6.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-share": "^12.3.1",
    "react-native-worklets": "^0.10.2",
    "react-redux": "9.3.0",
    "redux-saga": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
